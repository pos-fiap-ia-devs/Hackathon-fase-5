# ---- banco -------------------------------------------------------------
DATABASE_URL=postgresql://sdr:sdr@localhost:5433/sdr

# ---- LLM ---------------------------------------------------------------
# Modo demonstracao: roda o projeto INTEIRO sem Ollama, sem GPU e sem baixar
# modelo -- provedor de regras em app/core/llm_demo.py. Serve pra avaliar o
# fluxo em qualquer maquina (Windows/Linux inclusive). Respostas bem piores
# de proposito: demonstra FLUXO, nao qualidade de redacao.
#   LLM_DEMO=true python -m app.channels.cli
LLM_DEMO=false

# Ollama NATIVO, nunca em container no macOS: dentro do Docker nao ha Metal.
OLLAMA_HOST=http://localhost:11434
# Plano B de RAM/latencia, ambos ja em disco: qwen2.5:7b | llama3.1:8b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=90

# ---- canais ------------------------------------------------------------
# Token do BotFather. Vazio = Telegram desligado, web chat e CLI seguem funcionando.
TELEGRAM_BOT_TOKEN=
WEB_CHAT_ENABLED=true

# ---- transcricao de audio (Etapa 8, diferencial) ------------------------
STT_ENABLED=false
STT_MODEL=mlx-community/whisper-small-mlx
# Se o download automatico do HF Hub travar (visto em rede com reset de
# HTTP/2 no meio do arquivo de pesos): rode scripts/baixar_modelo_stt.sh e
# aponte aqui pro diretorio que ele baixa -- pula o cliente do HF Hub de vez.
STT_MODEL_PATH=
STT_MAX_AUDIO_S=60
STT_TIMEOUT_S=45

# ---- follow-up ---------------------------------------------------------
# DEMO_MODE=true encurta os intervalos para o follow-up acontecer ao vivo.
DEMO_MODE=true
FOLLOWUP_INTERVALOS_MIN=30,120,1440
FOLLOWUP_INTERVALOS_DEMO_S=90,180,300
FOLLOWUP_SCAN_S=30
FOLLOWUP_MAX_TENTATIVAS=3
# Fechamento por inatividade -- roda em paralelo ao follow-up acima (nao
# substitui). Fixo, nao escala com DEMO_MODE.
INATIVIDADE_FECHAMENTO_MIN=10

# ---- login do dashboard ------------------------------------------------
# Nao ha senha em variavel de ambiente: o primeiro acesso a /registro cria
# o administrador (o cadastro aberto fecha sozinho depois disso) e dali em
# diante so entra quem o admin convidar por link. Senhas ficam no Postgres
# como hash argon2id.
SESSAO_HORAS=12
CONVITE_HORAS=72
# true SO com HTTPS na frente. Em http://localhost o navegador nao devolve
# cookie `secure`, e o login entra em loop silencioso de volta pro /login.
COOKIE_SECURE=false

# ---- seguranca ---------------------------------------------------------
RATE_LIMIT_MSGS_POR_MIN=20
# Webhook de saida para CRM externo. Vazio = so o endpoint local /crm/leads.
CRM_WEBHOOK_URL=

# ---- observabilidade ---------------------------------------------------
# O custo real e zero: o modelo roda local. Estes precos calculam o
# CONTRAFACTUAL no painel -- quanto os tokens que o agent_traces ja mediu
# teriam custado numa API paga. Valor de referencia, ajuste pro preco do
# provedor com que voce quer comparar. Nao ha chamada a API de preco.
PRECO_REF_USD_POR_MI_ENTRADA=0.60
PRECO_REF_USD_POR_MI_SAIDA=2.40
# Cotacao fixa de referencia -- nao ha consulta de cambio.
COTACAO_USD_BRL=5.40
TRACES_JANELA_HORAS=24

# ---- widget embutivel --------------------------------------------------
# Dominios autorizados a embutir /embed num iframe, separados por virgula.
# Vira `frame-ancestors` no CSP -- quem recusa e o NAVEGADOR, nao o nosso
# codigo. Vazio = qualquer site pode embutir (default de POC, pra demo
# rodar sem configuracao). Em producao, liste:
#   WIDGET_DOMINIOS=https://imobiliaria.com.br,https://www.imobiliaria.com.br
WIDGET_DOMINIOS=

# ---- app ---------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
